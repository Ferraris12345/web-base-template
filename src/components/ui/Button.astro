---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'ghost-light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
} = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-gray-900 text-white hover:bg-gray-800 shadow-sm hover:shadow-md',
  secondary: 'bg-white text-gray-900 border border-gray-200 hover:bg-gray-50 hover:border-gray-300',
  ghost: 'text-gray-700 hover:text-gray-900 hover:bg-gray-100',
  'ghost-light': 'text-white/90 border border-white/30 hover:bg-white/10 hover:border-white/50',
};

const sizes: Record<string, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const classes = `inline-flex items-center justify-center gap-2 font-medium rounded-xl transition-all duration-200 active:scale-[0.98] ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}
