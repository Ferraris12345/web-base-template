---
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';

interface BlogPost {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  slug: string;
  category?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  posts?: BlogPost[];
}

const {
  title = 'Blog',
  subtitle = 'Artículos y novedades de nuestro equipo',
  posts = [
    {
      title: 'Título del artículo de ejemplo',
      excerpt: 'Una breve descripción del contenido del artículo. Lo suficiente para generar interés en el lector.',
      image: '/images/blog/post-01.webp',
      date: '2025-01-15',
      slug: 'articulo-ejemplo',
      category: 'General',
    },
    {
      title: 'Segundo artículo de ejemplo',
      excerpt: 'Otra descripción breve que resume el contenido principal y motiva al lector a hacer clic.',
      image: '/images/blog/post-02.webp',
      date: '2025-01-10',
      slug: 'segundo-articulo',
      category: 'Consejos',
    },
    {
      title: 'Tercer artículo de ejemplo',
      excerpt: 'Resumen del artículo que ofrece valor al visitante y demuestra experiencia en el tema.',
      image: '/images/blog/post-03.webp',
      date: '2025-01-05',
      slug: 'tercer-articulo',
      category: 'Noticias',
    },
  ],
} = Astro.props;

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('es-MX', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<section class="py-20 lg:py-28" id="blog" data-reveal>
  <Container>
    <SectionHeading title={title} subtitle={subtitle} />

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="group rounded-2xl overflow-hidden bg-white border border-gray-100 hover:shadow-sm transition-all duration-300">
          <a href={`/blog/${post.slug}`} class="block">
            <div class="aspect-[16/9] overflow-hidden">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                {post.category && (
                  <span class="text-xs font-medium uppercase tracking-wider text-gray-500">
                    {post.category}
                  </span>
                )}
                <time datetime={post.date} class="text-xs text-gray-400">
                  {formatDate(post.date)}
                </time>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-gray-700 transition-colors line-clamp-2">
                {post.title}
              </h3>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed line-clamp-2">
                {post.excerpt}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <Button href="/blog" variant="secondary">
        Ver todos los artículos
      </Button>
    </div>
  </Container>
</section>
