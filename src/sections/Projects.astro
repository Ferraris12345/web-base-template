---
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';

interface Project {
  image: string;
  title: string;
  client?: string;
  category?: string;
  description?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  projects: Project[];
}

const {
  title = 'Proyectos realizados',
  subtitle,
  projects,
} = Astro.props;
---

<section class="py-20 lg:py-28 bg-gray-50" id="proyectos" data-reveal>
  <Container>
    <SectionHeading title={title} subtitle={subtitle} />

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <div class="group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-md transition-shadow duration-300">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            {project.category && (
              <span class="text-xs font-medium uppercase tracking-wider text-gray-500">
                {project.category}
              </span>
            )}
            <h3 class="text-lg font-semibold text-gray-900 mt-1">{project.title}</h3>
            {project.client && (
              <p class="text-sm text-gray-500 mt-1">Cliente: {project.client}</p>
            )}
            {project.description && (
              <p class="text-sm text-gray-600 mt-3 leading-relaxed">{project.description}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
